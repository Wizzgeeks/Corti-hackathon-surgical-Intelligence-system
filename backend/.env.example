MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=corti_hackathon_opbook360

# Corti
CORTI_ENVIRONMENT=eu
CORTI_TENANT_NAME=base
CORTI_CLIENT_ID=<your-client-id>
CORTI_CLIENT_SECRET=<your-client-secret>

# MCP server (app/mcp_server)
# stdio: client launches it. http: listens on a port for remote clients.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Required before binding to anything but localhost — patient data.
# Public hostnames this server is reached by (ngrok, proxy, ingress).
# Without them the MCP SDK answers 421 Misdirected Request.
MCP_ALLOWED_HOSTS=
MCP_AUTH_TOKEN=

# Console project that owns the agentic agents, if different from above.
CORTI_AGENT_CLIENT_ID=
CORTI_AGENT_CLIENT_SECRET=

# ElevenLabs text to speech (the day briefing). Voice must be one the plan
# allows — free plans cannot use the shared voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
